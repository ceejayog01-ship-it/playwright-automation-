{
  "name": "headway-mt5-web-automation",
  "version": "1.0.0",
  "description": "Playwright automation for the Headway MT5 Web Terminal: verified login (demo or real), quotes, tick->candle export, read-only probe, guarded dummy order.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "login": "ts-node src/index.ts --mode=login",
    "order": "ts-node src/index.ts --mode=order",
    "install-browsers": "npx playwright install chromium",
    "quotes": "ts-node src/index.ts --mode=quotes",
    "ticks": "ts-node src/index.ts --mode=ticks",
    "probe": "ts-node src/index.ts --mode=probe",
    "test": "ts-node test/policy.test.ts && ts-node test/parsers.test.ts && ts-node test/order-guard.test.ts && ts-node test/chartparse.test.ts",
    "sample": "ts-node src/index.ts --mode=sample",
    "chartprobe": "ts-node src/index.ts --mode=chartprobe"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "dotenv": "^16.4.5",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
