{
  "name": "headway-mt5-web-automation",
  "version": "1.0.0",
  "description": "Demo-only Playwright automation for Headway MT5 Web Terminal (login + basic order). Stealth + resilient selectors.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "login": "ts-node src/index.ts --mode=login",
    "order": "ts-node src/index.ts --mode=order",
    "install-browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "dotenv": "^16.4.5",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
