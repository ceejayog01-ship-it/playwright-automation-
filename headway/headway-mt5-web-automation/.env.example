# ============================================
# ACCOUNT MODE  (demo is the default; real is an explicit opt-in)
# ============================================
ACCOUNT_MODE=demo
# REAL ONLY: the server name exactly as the login form shows it (required when ACCOUNT_MODE=real).
# The login aborts if the visible label, the URL path and the declared mode do not all agree.
EXPECTED_SERVER_LABEL=Headway-Demo
# Optional: pin the terminal host once you have seen it in the diagnostics (recommended for real).
EXPECTED_TERMINAL_HOST=

# ============================================
# REQUIRED
# ============================================
# demo: https://hw.online/webterminal/mt5-demo/    real: your real web-terminal URL (must NOT contain mt5-demo)
WEB_TERMINAL_URL=https://hw.online/webterminal/mt5-demo/
MT5_LOGIN=your_numeric_demo_account_number
MT5_PASSWORD=your_trading_password

# ============================================
# DUMMY ORDER GUARDS (order mode)
# ============================================
# Orders are a DRY RUN unless you pass --execute AND set this to exactly "yes".
ALLOW_ORDERS=no
# Real account + --execute also needs: REAL-<last 4 digits of MT5_LOGIN>
REAL_ORDER_CONFIRM=
ORDER_SYMBOLS=EURUSD

# ============================================
# PROXY (VERY IMPORTANT for GitHub Actions)
# ============================================
# Use a RESIDENTIAL proxy. Datacenter proxies (and GitHub Actions IPs)
# are frequently blocked by Cloudflare.
# Format examples:
#   http://username:password@gate.smartproxy.com:7000
#   http://user:pass@proxy.provider.com:8000
#   socks5://user:pass@proxy.provider.com:1080
PROXY_SERVER=

# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================
# Persistent Chrome profile (does NOT work well on GitHub Actions)
# Create a folder first: mkdir -p ~/headway-chrome-profile
USER_DATA_DIR=

# false = visible browser (best for first local tests)
# true  = required on GitHub Actions
HEADLESS=false

# Human-like delay (ms)
SLOW_MO=80

# Timeouts
DEFAULT_TIMEOUT=60000

# Demo mode only: abort if the server label contains any of these
BLOCKED_SERVER_KEYWORDS=Real,Live
